# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional (Day 9): powers auto-tagging photos for hidden, searchable tags
# (e.g. "wood", "brown"). Get a key from console.anthropic.com > API Keys.
# Without this set, photo uploads still work exactly the same — they just
# won't get any auto-detected tags.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# Add these same variables in Vercel: Project Settings > Environment Variables.
